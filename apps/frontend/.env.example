VITE_API_URL=http://localhost:3001
VITE_COLLAB_URL=ws://localhost:3002

# Firebase web app config — Firebase console → Project settings → Your apps.
# These are public by design (they identify the project, they don't authorize).
# Leave unset to hide the "Continue with Google" button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
