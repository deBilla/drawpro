generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String
  name                String?
  // E2EE fields (null until user sets up encryption)
  publicKey           String? // base64 raw 32-byte X25519 public key
  encryptedPrivateKey String? // base64 blob: iv(16)|AES-GCM(argon2id(passcode), pem)
  salt                String? // hex — used for argon2id and PBKDF2 recovery codes
  recoveryCodesData   String? // JSON: RecoveryCodeData[] — 6 PBKDF2-encrypted passcode backups
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[]
  apiTokens            ApiToken[]
}

/// Long-lived credential for non-browser clients (the CLI, Claude Code).
/// Only the SHA-256 of the token is stored — the token itself is shown once,
/// at creation, and is unrecoverable afterwards.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  /// Human label, e.g. "laptop CLI".
  name       String
  /// Leading, non-secret slice of the token, for identifying it in a list.
  prefix     String
  /// SHA-256 hex of the full token. Unique so lookup is a single indexed read.
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  encryptedName String? // base64 ECIES blob — client-encrypted name
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
  sheets  Sheet[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Sheet {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  // Plaintext storage (used when user has no encryption keys)
  elements      Json?
  appState      Json?
  // Encrypted storage — single blob: eph_pub(32)|iv(16)|authTag(16)|ciphertext
  encryptedData String?
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Anonymous usage aggregate from an opted-in MCP install.
///
/// Deliberately not linked to a User: the install id is generated on the
/// client and is not derived from an account, so reports can be grouped by
/// install without identifying whose it is. Nothing here describes a diagram.
model TelemetryReport {
  id         String   @id @default(cuid())
  /// Client-generated UUID, stable per install, not tied to an account.
  installId  String
  mcpVersion String
  calls      Int
  writes     Int
  /// [{ tool, calls, refused, failed, median_ms }]
  tools      Json
  receivedAt DateTime @default(now())

  @@index([installId])
  @@index([receivedAt])
}
