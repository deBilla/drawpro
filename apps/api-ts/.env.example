PORT=3001
# Supabase connection string (Session mode pooler — port 5432)
# Found in: Supabase dashboard → Project → Settings → Database → Connection string
# Local/compose Postgres. In deployment this line is replaced by the
# DATABASE_URL GitHub secret; 'postgres' is the compose service hostname.
DATABASE_URL=postgresql://drawpro:drawpro@postgres:5432/drawpro
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=604800
FRONTEND_URL=http://localhost:3000
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=drawpro
COLLAB_SECRET=change_me_collab_secret
